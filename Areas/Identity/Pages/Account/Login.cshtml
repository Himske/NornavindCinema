@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    ViewData["Cinema"] = true;
    ViewData["BodyClass"] = "cinema-body--login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="login-card">
        <section class="login-card__form" aria-labelledby="login-title">
            <h1 id="login-title">Welcome Back</h1>
            <p class="login-card__intro">Log in to your NornavindCinema account</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="login-card__error" role="alert"></div>
                <div class="login-card__field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                    <span asp-validation-for="Input.Email" class="login-card__error"></span>
                </div>
                <div class="login-card__field">
                    <label asp-for="Input.Password"></label>
                    <div class="login-card__password">
                        <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                        <button type="button" class="login-card__password-toggle" aria-controls="Input_Password" aria-pressed="false" hidden>Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="login-card__error"></span>
                </div>
                <div class="login-card__options">
                    <label class="login-card__remember" asp-for="Input.RememberMe">
                        <input asp-for="Input.RememberMe" /> Remember me
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>
                <button id="login-submit" type="submit" class="login-card__submit">Log in</button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0) {
                <div class="login-card__divider"><span>or log in with</span></div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="login-card__providers">
                    @foreach (var provider in Model.ExternalLogins!) {
                        <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                    }
                </form>
            }

            <div class="login-card__divider"><span>or</span></div>
            <p class="login-card__register">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a></p>
            <p class="login-card__confirmation"><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
        </section>

        <partial name="_AccountFeature" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
