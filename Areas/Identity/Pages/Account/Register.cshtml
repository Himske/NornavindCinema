@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["Cinema"] = true;
    ViewData["BodyClass"] = "cinema-body--login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="login-card">
        <section class="login-card__form" aria-labelledby="register-title">
            <h1 id="register-title">Create an account</h1>
            <p class="login-card__intro">Join NornavindCinema</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="login-card__error" role="alert"></div>
                <div class="login-card__field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                    <span asp-validation-for="Input.Email" class="login-card__error"></span>
                </div>
                <div class="login-card__field">
                    <label asp-for="Input.Password"></label>
                    <div class="login-card__password">
                        <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Create a password" />
                        <button type="button" class="login-card__password-toggle" aria-controls="Input_Password" aria-label="Show password" aria-pressed="false" hidden>Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="login-card__error"></span>
                </div>
                <div class="login-card__field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <div class="login-card__password">
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirm your password" />
                        <button type="button" class="login-card__password-toggle" aria-controls="Input_ConfirmPassword" aria-label="Show confirm password" aria-pressed="false" hidden>Show</button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="login-card__error"></span>
                </div>
                <button id="registerSubmit" type="submit" class="login-card__submit">Register</button>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0) {
                <div class="login-card__divider"><span>or register with</span></div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="login-card__providers">
                    @foreach (var provider in Model.ExternalLogins!) {
                        <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                    }
                </form>
            }

            <div class="login-card__divider"><span>or</span></div>
            <p class="login-card__register">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
        </section>

        <partial name="_AccountFeature" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
