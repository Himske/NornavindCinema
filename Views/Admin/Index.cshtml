@{
    ViewData["Title"] = "Administration";
}

<section class="movie-management">
    <div class="movie-management__header">
        <div>
            <h1>Administration</h1>
            <p>Manage application data.</p>
        </div>
    </div>

    @if (TempData["SeedResult"] is string message) {
        <div class="alert alert-success mt-3" role="status">@message</div>
    }

    <div class="pt-3">
        <h2 class="h5">Users and reviews</h2>
        <p>Manage user roles and accounts, or moderate member reviews.</p>
        <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-primary">Manage users</a>
        <a asp-controller="AdminReviews" asp-action="Index" class="btn btn-outline-primary">Moderate reviews</a>
    </div>

    <div class="pt-3">
        <h2 class="h5">API configuration</h2>
        <p>Manage the OMDB and TMDB credentials.</p>
        <a asp-controller="ApiConfiguration" asp-action="Index" class="btn btn-outline-primary">Configure APIs</a>
    </div>

    <div class="pt-3">
        <h2 class="h5">Search OMDB</h2>
        <p>Search OMDB and import individual movies.</p>
        <a asp-controller="Omdb" asp-action="Index" class="btn btn-outline-primary">Search OMDB</a>
    </div>

    <div class="pt-3">
        <h2 class="h5">Search TMDB</h2>
        <p>Search TMDB and import individual movies.</p>
        <a asp-controller="Tmdb" asp-action="Index" class="btn btn-outline-primary">Search TMDB</a>
    </div>

    <div class="pt-3">
        <h2 class="h5">Seed movie data</h2>
        <p>Import the bundled OMDB movie data. Movies with an IMDb ID already in the database are skipped; existing movies are not changed.</p>
        <form asp-action="SeedMovies" method="post">
            <button type="submit" class="btn btn-primary">Seed movies</button>
        </form>
    </div>
</section>
