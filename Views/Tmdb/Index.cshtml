@model NornavindCinema.ViewModels.TmdbSearchViewModel
@{
    ViewData["Title"] = "Search TMDB";
}

<section class="movie-management">
    <div class="movie-management__header">
        <div>
            <h1>Search TMDB</h1>
            <p>Find movies and import their full details.</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Back to administration</a>
    </div>

    @if (TempData["TmdbMessage"] is string message) {
        <div class="alert alert-success mt-3" role="status">@message</div>
    }
    @if (TempData["TmdbError"] is string error) {
        <div class="alert alert-danger mt-3" role="alert">@error</div>
    }
    <form asp-action="Index" method="get" class="movie-toolbar">
        <div class="movie-filters">
            <label for="tmdb-query" class="visually-hidden">Search movies</label>
            <input id="tmdb-query" name="query" value="@Model.Query" class="form-control" type="search" maxlength="100" required placeholder="Search movies..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>
    @if (Model.Error is not null) {
        <div class="alert alert-warning" role="alert">@Model.Error</div>
    }
    @if (Model.Results.Count > 0) {
        <p>@Model.TotalResults results</p>
        <div class="table-responsive">
            <table class="table movie-table">
                <thead><tr><th scope="col">Title</th><th scope="col">Release date</th><th scope="col">Action</th></tr></thead>
                <tbody>
                    @foreach (var movie in Model.Results) {
                        <tr>
                            <td><div class="movie-title-cell">
                                @if (movie.PosterPath is not null) {
                                    <img class="movie-poster" src="@movie.PosterPath" alt="" loading="lazy" />
                                }
                                else {
                                    <div class="movie-poster movie-poster--empty" aria-hidden="true">&#127916;</div>
                                }
                                <span>@movie.Title</span>
                            </div></td>
                            <td>@(string.IsNullOrWhiteSpace(movie.ReleaseDate) ? "N/A" : movie.ReleaseDate)</td>
                            <td>
                                @if (movie.AlreadyImported) {
                                    <span>Already imported</span>
                                }
                                else {
                                    <form asp-action="Import" method="post">
                                        <input type="hidden" name="id" value="@movie.Id" />
                                        <input type="hidden" name="query" value="@Model.Query" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <button type="submit" class="btn btn-primary btn-sm">Import</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.Results.Count > 0 || (Model.Page > 1 && Model.TotalPages > 0)) {
        <nav class="movie-table-footer" aria-label="TMDB search pages">
            <span>Page @Model.Page</span>
            <div class="d-flex gap-2">
                @if (Model.Page > 1) {
                    <a asp-action="Index" asp-route-query="@Model.Query" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary btn-sm">Previous</a>
                }
                @if (Model.Page < 500 && Model.Page < Model.TotalPages) {
                    <a asp-action="Index" asp-route-query="@Model.Query" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary btn-sm">Next</a>
                }
            </div>
        </nav>
    }
    <p class="mt-3">Movie data provided by TMDB.</p>
</section>
