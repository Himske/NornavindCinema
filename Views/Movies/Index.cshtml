@model IEnumerable<NornavindCinema.Models.Movie>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Manage Movies";
    var isAdministrator = (await AuthorizationService.AuthorizeAsync(User, "Administrator")).Succeeded;
    var movies = Model.ToList();
    var genres = movies.SelectMany(movie => movie.Genres)
        .Where(genre => !string.IsNullOrWhiteSpace(genre))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(genre => genre, StringComparer.OrdinalIgnoreCase);
}

<section class="movie-management">
    <div class="movie-management__header">
        <div>
            <h1>Manage Movies</h1>
            <p>View, search and manage all movies in the system.</p>
        </div>
        @if (isAdministrator) {
            <a asp-action="Create" class="btn btn-primary movie-add-button">
                <span aria-hidden="true">+</span> Add New Movie
            </a>
        }
    </div>

    <div class="movie-toolbar">
        <div class="movie-filters">
            <label class="movie-search">
                <span class="visually-hidden">Search by title</span>
                <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                <input id="movie-search" type="search" placeholder="Search by title..." autocomplete="off" />
            </label>
            <label>
                <span class="visually-hidden">Filter by genre</span>
                <select id="movie-genre" class="form-select">
                    <option value="">All Genres</option>
                    @foreach (var genre in genres) {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </label>
        </div>
        <div class="movie-summary">
            <span id="movie-count" aria-live="polite"></span>
            <button id="movie-refresh" type="button" class="btn btn-outline-secondary movie-refresh" aria-label="Reset search and filters" title="Reset search and filters">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 7v5h-5"></path><path d="M19 12a7 7 0 1 1-2-5l3 5"></path></svg>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table movie-table">
            <thead>
                <tr>
                    <th scope="col" class="movie-number">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Genre</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Release Date</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody id="movie-rows">
                @foreach (var movie in movies) {
                    var rating = movie.Ratings.FirstOrDefault(item => item.Source == "Internet Movie Database")?.Value ?? movie.ImdbRating;
                    <tr data-title="@movie.Title" data-genres="@string.Join("|", movie.Genres)">
                        <td class="movie-number"></td>
                        <td>
                            <div class="movie-title-cell">
                                @if (!string.IsNullOrWhiteSpace(movie.Poster)) {
                                    <img class="movie-poster" src="@movie.Poster" alt="" loading="lazy" />
                                }
                                else {
                                    <div class="movie-poster movie-poster--empty" aria-hidden="true">🎬</div>
                                }
                                <a asp-action="Details" asp-route-id="@movie.Id" class="movie-title">@movie.Title</a>
                            </div>
                        </td>
                        <td>@string.Join(", ", movie.Genres)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(rating)) {
                                <span class="movie-rating"><span aria-hidden="true">★</span> @rating</span>
                            }
                            else {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(movie.Released?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                        <td>
                            <div class="movie-actions">
                                @if (isAdministrator) {
                                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-primary btn-sm">
                                        <span aria-hidden="true">✎</span> Edit
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-secondary btn-sm">
                                    <span aria-hidden="true">◉</span> Details
                                </a>
                                @if (isAdministrator) {
                                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-danger btn-sm">
                                        <span aria-hidden="true">▣</span> Delete
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                <tr id="movie-empty" hidden>
                    <td colspan="6" class="movie-empty">No movies match your search.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="movie-table-footer">
        <span id="movie-page-info"></span>
        <nav class="movie-pagination" aria-label="Movie list pages">
            <button id="movie-previous" type="button" aria-label="Previous page">‹</button>
            <span id="movie-page-number" aria-current="page">1</span>
            <button id="movie-next" type="button" aria-label="Next page">›</button>
        </nav>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const rows = Array.from(document.querySelectorAll("#movie-rows tr[data-title]"));
            const search = document.getElementById("movie-search");
            const genre = document.getElementById("movie-genre");
            const count = document.getElementById("movie-count");
            const pageInfo = document.getElementById("movie-page-info");
            const pageNumber = document.getElementById("movie-page-number");
            const emptyMessage = document.getElementById("movie-empty");
            const previous = document.getElementById("movie-previous");
            const next = document.getElementById("movie-next");
            const refresh = document.getElementById("movie-refresh");

            if (!(search instanceof HTMLInputElement) || !(genre instanceof HTMLSelectElement)
                || !count || !pageInfo || !pageNumber || !emptyMessage
                || !(previous instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement) || !refresh) {
                throw new Error("Movie list controls are missing or invalid.");
            }

            const pageSize = 8;
            let currentPage = 1;
            let filteredRows = rows;

            const render = () => {
                const query = search.value.trim().toLocaleLowerCase();
                const selectedGenre = genre.value.toLocaleLowerCase();
                filteredRows = rows.filter(row => {
                    const title = row.getAttribute("data-title");
                    const genreValues = row.getAttribute("data-genres");
                    if (title === null || genreValues === null) {
                        throw new Error("Movie row data is missing.");
                    }
                    const titleMatches = title.toLocaleLowerCase().includes(query);
                    const genres = genreValues.split("|").map(value => value.trim().toLocaleLowerCase());
                    return titleMatches && (!selectedGenre || genres.includes(selectedGenre));
                });

                const pageCount = Math.max(1, Math.ceil(filteredRows.length / pageSize));
                currentPage = Math.min(currentPage, pageCount);
                const start = (currentPage - 1) * pageSize;
                const visibleRows = new Set(filteredRows.slice(start, start + pageSize));

                rows.forEach(row => {
                    if (!(row instanceof HTMLTableRowElement)) {
                        throw new Error("Invalid movie row.");
                    }
                    row.hidden = !visibleRows.has(row);
                    if (visibleRows.has(row)) {
                        const number = row.querySelector(".movie-number");
                        if (!number) {
                            throw new Error("Movie row number is missing.");
                        }
                        number.textContent = String(filteredRows.indexOf(row) + 1);
                    }
                });

                emptyMessage.hidden = filteredRows.length !== 0;
                count.textContent = `Showing ${filteredRows.length ? start + 1 : 0} to ${Math.min(start + pageSize, filteredRows.length)} of ${filteredRows.length} movies`;
                pageInfo.textContent = `Showing ${filteredRows.length ? start + 1 : 0} to ${Math.min(start + pageSize, filteredRows.length)} of ${filteredRows.length} entries`;
                pageNumber.textContent = String(currentPage);
                previous.disabled = currentPage <= 1;
                next.disabled = currentPage >= pageCount;
            };

            search.addEventListener("input", () => { currentPage = 1; render(); });
            genre.addEventListener("change", () => { currentPage = 1; render(); });
            previous.addEventListener("click", () => { currentPage--; render(); });
            next.addEventListener("click", () => { currentPage++; render(); });
            refresh.addEventListener("click", () => {
                search.value = "";
                genre.value = "";
                currentPage = 1;
                render();
            });

            render();
        })();
    </script>
}
