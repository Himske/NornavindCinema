@model IEnumerable<NornavindCinema.Models.Movie>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Manage Movies";
    var isAdministrator = (await AuthorizationService.AuthorizeAsync(User, "Administrator")).Succeeded;
    var movies = Model.ToList();
    var genres = movies.SelectMany(movie => movie.Genres)
        .Where(genre => !string.IsNullOrWhiteSpace(genre))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(genre => genre, StringComparer.OrdinalIgnoreCase);
}

<section class="movie-management">
    <div class="movie-management__header">
        <div>
            <h1>Movies</h1>
            <p>View and search all movies in the system.</p>
        </div>
        @if (isAdministrator) {
            <a asp-action="Create" class="btn btn-primary movie-button--blue movie-add-button">
                <span aria-hidden="true">+</span> Add New Movie
            </a>
        }
    </div>

    <div id="movie-state-warning" class="alert alert-warning mt-3" role="alert" hidden>Movie list state could not be saved in this browser.</div>
    <div class="movie-toolbar">
        <div class="movie-filters">
            <label class="movie-search">
                <span class="visually-hidden">Search by title</span>
                <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                <input id="movie-search" type="search" placeholder="Search by title..." autocomplete="off" />
            </label>
            <label>
                <span class="visually-hidden">Filter by genre</span>
                <select id="movie-genre" class="form-select">
                    <option value="">All Genres</option>
                    @foreach (var genre in genres) {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </label>
        </div>
        <div class="movie-summary">
            <span id="movie-count" aria-live="polite"></span>
            <button id="movie-refresh" type="button" class="btn btn-outline-secondary movie-refresh" aria-label="Reset search and filters" title="Reset search and filters">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 7v5h-5"></path><path d="M19 12a7 7 0 1 1-2-5l3 5"></path></svg>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table movie-table">
            <thead>
                <tr>
                    <th scope="col" class="movie-number">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Genre</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Release Date</th>
                    @if (isAdministrator) {
                        <th scope="col">Actions</th>
                    }
                </tr>
            </thead>
            <tbody id="movie-rows">
                @foreach (var movie in movies) {
                    var rating = movie.Ratings.FirstOrDefault(item => item.Source == "Internet Movie Database")?.Value ?? movie.ImdbRating;
                    <tr data-title="@movie.Title" data-genres="@string.Join("|", movie.Genres)">
                        <td class="movie-number"></td>
                        <td>
                            <div class="movie-title-cell">
                                @if (!string.IsNullOrWhiteSpace(movie.Poster)) {
                                    <img class="movie-poster" src="@movie.Poster" alt="" loading="lazy" />
                                }
                                else {
                                    <div class="movie-poster movie-poster--empty" aria-hidden="true">🎬</div>
                                }
                                <a asp-action="Details" asp-route-id="@movie.Id" class="movie-title">@movie.Title</a>
                            </div>
                        </td>
                        <td>@string.Join(", ", movie.Genres)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(rating)) {
                                <span class="movie-rating"><span aria-hidden="true">★</span> @rating</span>
                            }
                            else {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(movie.Released?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                        @if (isAdministrator) {
                            <td>
                                <div class="movie-actions">
                                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-primary movie-button--blue btn-sm">
                                        <span aria-hidden="true">✎</span> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-primary btn-sm">
                                        <svg class="movie-actions__icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v5a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1h2.5a1 1 0 0 1 1 1M4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3v.001h11V3z"/></svg> Delete
                                    </a>
                                </div>
                            </td>
                        }
                    </tr>
                }
                <tr id="movie-empty" hidden>
                    <td colspan="@(isAdministrator ? 6 : 5)" class="movie-empty">No movies match your search.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="movie-table-footer">
        <span id="movie-page-info"></span>
        <nav class="movie-pagination" aria-label="Movie list pages">
            <button id="movie-first" type="button" aria-label="First page">«</button>
            <button id="movie-previous" type="button" aria-label="Previous page">‹</button>
            <span id="movie-page-number" aria-current="page">1</span>
            <button id="movie-next" type="button" aria-label="Next page">›</button>
            <button id="movie-last" type="button" aria-label="Last page">»</button>
        </nav>
    </div>
</section>

@section Scripts {
    <script src="~/js/movies.js" asp-append-version="true"></script>
}
