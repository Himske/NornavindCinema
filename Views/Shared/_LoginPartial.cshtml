@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NornavindCinema.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject IAuthorizationService AuthorizationService

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <button class="nav-link dropdown-toggle btn" type="button" id="accountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            Hello @User.Identity?.Name!
        </button>
        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" aria-labelledby="accountDropdown">
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Manage account</a></li>
            @if ((await AuthorizationService.AuthorizeAsync(User, "MovieMember")).Succeeded)
            {
                <li><a class="dropdown-item" asp-area="" asp-controller="Movies" asp-action="Favorites">My favorites</a></li>
            }
            @if ((await AuthorizationService.AuthorizeAsync(User, "Administrator")).Succeeded)
            {
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Index">Administration</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="AdminUsers" asp-action="Index">Manage users</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="AdminReviews" asp-action="Index">Moderate reviews</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="ApiConfiguration" asp-action="Index">Configure APIs</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item">Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
